# ZT hook configuration — deployed to /etc/openvpn/zt/hook.env (mode 0644).
# Contains no secrets (paths only), safe for the unprivileged `nobody` user.
#
# PDP_ENFORCE=1 -> fail-closed: every decision comes from the PDP; if it is
#                  unreachable the connection is denied (M3+).
# PDP_ENFORCE=0 -> bootstrap while the PDP is not built yet (M2): OpenVPN still
#                  enforces mTLS + CRL, the hooks only log. Flip to 1 at M3.
PDP_ENFORCE=1

# PDP endpoint (FastAPI over mTLS, docs/06 §5)
PDP_URL=https://10.10.99.10:8443
PDP_TIMEOUT=2

# mTLS material the gateway uses to authenticate to the PDP.
# Only required when PDP_ENFORCE=1. Issued at M3 (server_client_cert profile).
PDP_CA=/etc/openvpn/hooks/ca-chain.crt
PDP_CERT=/etc/openvpn/hooks/gw-client.crt
PDP_KEY=/etc/openvpn/hooks/gw-client.key

# Fixed VPN IP per CN (docs/05 §5.2)
IP_MAP=/etc/openvpn/zt/ip-map.csv
VPN_NETMASK=255.255.255.0
