# Copy to /etc/zt-pdp/pdp.env on zt-pdp; private material stays in /etc/zt-pdp/certs.
ZT_REDIS_URL=redis://redis:6379/0
ZT_OPA_URL=http://opa:8181/v1/data/zt/authz/decision
ZT_SESSION_TTL=600
ZT_RENEWAL_INTERVAL=60
ZT_GATEWAY_HOST=10.10.99.1
ZT_GATEWAY_USER=ztpdp
ZT_GATEWAY_KEY=/run/secrets/gateway_ssh_key
ZT_ENFORCER_DRY_RUN=false
