# ZT-PKI-AI local Suricata rules (docs/08 §3.3), tuned to the lab address plan.
# HOME_NET covers the lab zones + VPN pool (set in suricata.yaml by the role).

# Many SYNs from one source in a short window: horizontal/vertical scan.
alert tcp $HOME_NET any -> $HOME_NET any (msg:"ZT internal scan (SYN burst from one source)"; flow:stateless; flags:S,12; threshold:type both, track by_src, count 50, seconds 10; classtype:attempted-recon; sid:9000001; rev:2;)

# Repeated new connections to the admin SSH host: password guessing.
alert tcp any any -> 10.10.20.10 22 (msg:"ZT SSH brute force on web-app"; flow:to_server; flags:S,12; threshold:type both, track by_src, count 10, seconds 30; classtype:attempted-admin; sid:9000002; rev:2;)

# Unusually long DNS names: possible DNS tunnelling.
alert dns any any -> any any (msg:"ZT long DNS query (possible tunnel)"; dns.query; pcre:"/^.{60,}$/"; classtype:policy-violation; sid:9000003; rev:2;)

# Any VPN client reaching the management zone outside the PDP posture channel.
alert tcp 10.8.0.0/24 any -> 10.10.99.0/24 !8443 (msg:"ZT VPN client to mgmt zone (not posture channel)"; flow:to_server; flags:S,12; classtype:policy-violation; sid:9000004; rev:1;)

# Pipeline self-test (harmless): a marker in the URL of the plain-HTTP
# proxy -> app hop. Proves mirror -> Suricata -> eve.json -> Wazuh end to end.
alert http any any -> 10.10.20.10 8080 (msg:"ZT IDS pipeline self-test"; flow:to_server,established; http.uri; content:"zt-ids-selftest"; classtype:misc-activity; sid:9000099; rev:1;)
